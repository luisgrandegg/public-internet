# PostgreSQL connection string.
# For local development with docker-compose.yml: postgres://eats:eats@localhost:5433/eats
DATABASE_URL="postgresql://eats:eats@localhost:5433/eats"

# Secret used by better-auth for session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<random-32-char-secret>"

# Public base URL of this app — used by better-auth for redirects and the SDK base URL.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Flat infrastructure fee charged per order, in cents (integer).
# Constitution: this is a flat fee covering operating costs — never a percentage,
# never demand-adjusted. Published to customers before they confirm an order.
# Default: 99 (€0.99) — suitable for a small local node.
EATS_INFRASTRUCTURE_FEE_CENTS="99"

# Courier pay (transparent to the worker, shown separately on every delivery).
# Constitution: pay must always be shown as basePay + distancePay — never as an
# opaque total. Couriers are workers with rights, not contractors.
EATS_COURIER_BASE_PAY_CENTS="400"
EATS_COURIER_DISTANCE_PAY_CENTS="200"

# ── Online payments (optional — ADR-006) ────────────────────────────────────
# Stripe secret key for this node's OWN Stripe account (federation-first:
# payment credentials belong to the node operator, never a central authority).
# When UNSET the node runs in offline-settlement mode: orders are recorded as
# settled directly (pay on delivery) — a legitimate operating mode for a
# commission-free node, not a stub. When SET, order confirmation redirects to
# a hosted Stripe Checkout page charging exactly the pre-confirmation total
# (items + published flat infrastructure fee — nothing else, ever).
# STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret for POST /api/webhooks/stripe (from the Stripe
# dashboard or `stripe listen`). Required whenever STRIPE_SECRET_KEY is set —
# only the signature-verified checkout.session.completed event marks a
# payment as SUCCEEDED; the browser redirect alone is never trusted.
# STRIPE_WEBHOOK_SECRET="whsec_..."
