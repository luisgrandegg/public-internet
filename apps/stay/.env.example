# PostgreSQL connection string used by the app at runtime.
# For local development: start the database with `docker compose up -d`
# then use the connection string below (matches docker-compose.yml defaults).
# For production: point at an operator-owned PostgreSQL instance.
# On Supabase: use the *transaction pooler* string (port 6543).
DATABASE_URL="postgresql://stay:stay@localhost:5432/stay"

# Direct (non-pooled) connection string used ONLY by the Prisma CLI for
# migrations (db:migrate / db:deploy). Required when DATABASE_URL points at a
# connection pooler (Supabase/Supavisor, pgbouncer) — poolers cannot run
# migrations. On Supabase: use the *session/direct* string (port 5432).
# Locally you can omit it (falls back to DATABASE_URL).
# DIRECT_URL="postgresql://stay:stay@localhost:5432/stay"

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. Rotate if compromised.
BETTER_AUTH_SECRET="replace-with-32-char-random-secret"

# Public base URL of this deployment.
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Sign in with Google (optional — ADR-007, per-node) ──────────────────────
# This node operator's OWN Google Cloud OAuth credentials (Web application
# client). When BOTH are set, the auth server enables the Google strategy and
# the sign-in/sign-up pages offer "Continue with Google". Unset → email +
# password only; the node is fully functional without them (ADR-004: no OAuth
# dependency — Google is a per-node convenience, never a requirement).
# Authorized redirect URI to register in the Google Cloud Console:
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (local dev)
# GOOGLE_CLIENT_ID="<oauth client id>.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="<oauth client secret>"

# ─── Online payments (optional — ADR-006, pluggable provider) ────────────────
# The payment layer is a PaymentProvider interface (src/lib/payments/); Stripe
# is the built-in implementation. When NO provider is configured, the node runs
# in offline settlement mode: bookings are confirmed with a 'pay at the
# property' payment record and no online payment is taken.

# Secret API key for the node operator's OWN Stripe account (never a central one).
# When SET, booking confirmation redirects to a hosted Stripe Checkout Session
# charging exactly the displayed total — no fees or surcharges are ever added.
# STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret for POST /api/webhooks/payments (from the Stripe
# dashboard, or `stripe listen` in local dev). Required in Stripe mode —
# payment confirmation arrives only via the signature-verified webhook.
# STRIPE_WEBHOOK_SECRET="whsec_..."
# A custom provider (src/lib/payments/<yourprovider>.ts) defines its own env
# vars — document them here when you add one.
