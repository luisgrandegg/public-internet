# PostgreSQL connection string used by the app at runtime.
# For local development with docker-compose.yml: postgres://eats:eats@localhost:5433/eats
# For production on Neon: use the POOLED connection string (hostname contains `-pooler`).
DATABASE_URL="postgresql://eats:eats@localhost:5433/eats"

# Direct (non-pooled) connection string used ONLY by `prisma migrate`.
# Required on Neon because migrations cannot run through pgBouncer.
# Leave unset for local/CI — prisma.config.ts falls back to DATABASE_URL.
# DIRECT_URL="postgresql://...neon.tech/...?sslmode=require"

# Secret used by better-auth for session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<random-32-char-secret>"

# Public base URL of this app — used by better-auth for redirects and the SDK base URL.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
