# ElevenLabs Conversational AI
# Create an agent at https://elevenlabs.io/app/conversational-ai and copy its ID.
# The agent must be configured with the tools listed in src/lib/voice/agent-tools.ts.
ELEVENLABS_AGENT_ID=""

# Server-side API key. Used only by /api/voice/signed-url to mint short-lived
# signed websocket URLs so the public agent ID is never embedded in the client.
ELEVENLABS_API_KEY=""

# Where voice spec files are written, relative to the monorepo root.
# Default matches the .voice-changes/ path Claude Code's /voice-changes reads from.
VOICE_SPEC_DIR=".voice-changes"
