# PostgreSQL connection string used by the app at runtime.
# For local development: start the database with `docker compose up -d`
# then use the connection string below (matches docker-compose.yml defaults).
# For production on Neon: use the POOLED connection string (hostname contains `-pooler`).
DATABASE_URL="postgresql://touristical:touristical@localhost:5432/touristical_renting"

# Direct (non-pooled) connection string used ONLY by `prisma migrate`.
# Required on Neon because migrations cannot run through pgBouncer.
# Leave unset for local/CI — prisma.config.ts falls back to DATABASE_URL.
# DIRECT_URL="postgresql://...neon.tech/...?sslmode=require"

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. Rotate if compromised.
BETTER_AUTH_SECRET="replace-with-32-char-random-secret"

# Public base URL of this deployment.
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
